{
  "resourceType": "https://sql-on-fhir.org/ig/StructureDefinition/ViewDefinition",
  "name": "MII PR Prozedur Procedure",
  "status": "draft",
  "resource": "Procedure",
  "select": [
    {
      "column": [
        {
          "name": "id",
          "path": "id"
        },
        {
          "name": "patient",
          "path": "subject.reference"
        }
      ]
    },
    {
      "select": [
        {
          "select": [
            {
              "column": [
                {
                  "name": "Procedure_bodySite_codingSnomedct_code",
