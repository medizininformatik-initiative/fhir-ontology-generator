    {
      "select": [
        {
          "column": [
            {
              "name": "Procedure_performed_X_Performedperiod_end",
              "path": "end",
              "type": "dateTime"
            }
          ]
        },
        {
          "column": [
            {
              "name": "Procedure_performed_X_Performedperiod_start",
              "path": "start",
              "type": "dateTime"
            }
          ]
        }
      ],
      "forEachOrNull": "performed.ofType(Period)"
    },
    {
      "column": [
        {
          "name": "Procedure_status",
