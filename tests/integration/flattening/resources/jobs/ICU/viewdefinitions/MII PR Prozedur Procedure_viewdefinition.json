                }
              ]
            },
            {
              "column": [
                {
                  "name": "Procedure_bodySite_codingSnomedct_system",
                  "path": "system",
                  "type": "uri"
                }
              ]
            },
            {
              "column": [
                {
                  "name": "Procedure_bodySite_codingSnomedct_version",
                  "path": "version",
                  "type": "string"
                }
              ]
            }
          ],
          "forEachOrNull": "coding.where(system = 'http://snomed.info/sct')"
        }
      ],
      "forEachOrNull": "bodySite"
    },
    {
      "select": [
        {
          "select": [
            {
              "column": [
                {
                  "name": "Procedure_code_codingOps_code",
